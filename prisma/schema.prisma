generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email            String                 @unique
  passwordHash     String                 @map("password_hash")
  name             String?
  role             String                 @default("admin")
  isActive         Boolean?               @default(true) @map("is_active")
  lastLoginAt      DateTime?              @map("last_login_at") @db.Timestamptz(6)
  createdAt        DateTime?              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime?              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  sellerProfile    Seller?                @relation("SellerAccount")
  sessions         AppSession[]
  locationAccess   UserLocationAccess[]
  reconciliations  WalletReconciliation[] @relation("WalletReconciledBy")
  notifications    UserNotification[]
  ledgerEntries    FinanceLedgerEntry[]   @relation("LedgerActor")
  reviewedExpenses Expense[]              @relation("ExpenseReviewedBy")
  voidedSales      Sale[]                 @relation("SaleVoidedBy")

  @@index([email], map: "idx_users_email")
  @@map("users")
}

model AppSession {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  userAgentHash String?   @map("user_agent_hash")
  ipHash        String?   @map("ip_hash")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt(sort: Desc)], map: "idx_app_sessions_user_active")
  @@map("app_sessions")
}

model UserLocationAccess {
  userId          String   @map("user_id") @db.Uuid
  locationId      String   @map("location_id") @db.Uuid
  canManageWallet Boolean  @default(true) @map("can_manage_wallet")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location        Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([userId, locationId])
  @@index([locationId, userId], map: "idx_user_location_access_location")
  @@map("user_location_access")
}

model ActivityLog {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  action           String
  entityType       String    @map("entity_type")
  entityId         String?   @map("entity_id")
  entityName       String?   @map("entity_name")
  details          String?
  userId           String?   @map("user_id") @db.Uuid
  actorUserId      String?   @map("actor_user_id") @db.Uuid
  actorEmail       String?   @map("actor_email")
  actorName        String?   @map("actor_name")
  actorRole        String?   @map("actor_role")
  operatorId       String?   @map("operator_id")
  operatorName     String?   @map("operator_name")
  operatorSource   String?   @map("operator_source")
  operatorSession  String?   @map("operator_session")
  requestId        String?   @map("request_id")
  requestMethod    String?   @map("request_method")
  requestPath      String?   @map("request_path")
  source           String?
  ipHash           String?   @map("ip_hash")
  userAgentHash    String?   @map("user_agent_hash")
  metadata         Json?
  checksum         String?
  previousChecksum String?   @map("previous_checksum")
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([action], map: "idx_activity_logs_action")
  @@index([actorUserId], map: "idx_activity_logs_actor_user")
  @@index([createdAt(sort: Desc)], map: "idx_activity_logs_created")
  @@index([entityType], map: "idx_activity_logs_entity")
  @@index([operatorName, createdAt(sort: Desc)], map: "idx_activity_logs_operator_created")
  @@index([requestPath, createdAt(sort: Desc)], map: "idx_activity_logs_request_created")
  @@map("activity_logs")
}

model SiteAnalyticsEvent {
  id                 String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  eventType          String   @map("event_type")
  route              String
  path               String
  catalogType        String?  @map("catalog_type")
  visitorId          String?  @map("visitor_id")
  sessionId          String?  @map("session_id")
  referrerHost       String?  @map("referrer_host")
  source             String?
  deviceType         String?  @map("device_type")
  viewportWidth      Int?     @map("viewport_width")
  viewportHeight     Int?     @map("viewport_height")
  connectionType     String?  @map("connection_type")
  metricName         String?  @map("metric_name")
  metricValue        Float?   @map("metric_value")
  metricRating       String?  @map("metric_rating")
  metricId           String?  @map("metric_id")
  navigationType     String?  @map("navigation_type")
  loadTimeMs         Int?     @map("load_time_ms")
  ttfbMs             Int?     @map("ttfb_ms")
  domContentLoadedMs Int?     @map("dom_content_loaded_ms")
  country            String?
  userAgentHash      String?  @map("user_agent_hash")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([catalogType, createdAt(sort: Desc)], map: "idx_site_analytics_catalog_created")
  @@index([createdAt(sort: Desc)], map: "idx_site_analytics_created")
  @@index([eventType, createdAt(sort: Desc)], map: "idx_site_analytics_event_created")
  @@index([metricName, createdAt(sort: Desc)], map: "idx_site_analytics_metric_created")
  @@index([route, createdAt(sort: Desc)], map: "idx_site_analytics_route_created")
  @@map("site_analytics_events")
}

model InvoiceSequence {
  prefix     String   @id
  lastNumber BigInt   @default(0) @map("last_number")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("invoice_sequences")
}

model StoreSetting {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  key       String    @unique
  value     String
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("store_settings")
}

model Company {
  id                     String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name                   String
  legalName              String?  @map("legal_name")
  baseCurrency           String   @default("SRD") @map("base_currency")
  taxId                  String?  @map("tax_id")
  fiscalYearStartMonth   Int      @default(1) @map("fiscal_year_start_month")
  isActive               Boolean  @default(true) @map("is_active")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("companies")
}

model Category {
  id                    String                  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name                  String
  catalogType           String                  @default("audio") @map("catalog_type")
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  commissions           Commission[]
  items                 Item[]
  seller_category_rates seller_category_rates[]

  @@map("categories")
}

model Item {
  id                                      String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name                                    String
  brand                                   String?
  categoryId                              String?             @map("category_id") @db.Uuid
  purchasePriceUsd                        Decimal             @map("purchase_price_usd") @db.Decimal(18, 4)
  sellingPriceSrd                         Decimal?            @map("selling_price_srd") @db.Decimal(18, 4)
  sellingPriceUsd                         Decimal?            @map("selling_price_usd") @db.Decimal(18, 4)
  imageUrl                                String?             @map("image_url")
  createdAt                               DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                               DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  description                             String?
  isPublic                                Boolean?            @default(true) @map("is_public")
  is_combo                                Boolean?            @default(false)
  allow_custom_price                      Boolean?            @default(false)
  deletedAt                               DateTime?           @map("deleted_at") @db.Timestamptz(6)
  catalogType                             String              @default("audio") @map("catalog_type")
  needsReview                             Boolean             @default(false) @map("needs_review")
  reviewReason                            String?             @map("review_reason")
  combo_items_combo_items_combo_idToitems combo_items[]       @relation("combo_items_combo_idToitems")
  combo_items_combo_items_item_idToitems  combo_items[]       @relation("combo_items_item_idToitems")
  category                                Category?           @relation(fields: [categoryId], references: [id])
  purchaseOrderItems                      PurchaseOrderItem[]
  reservations                            Reservation[]
  saleItems                               SaleItem[]
  stock                                   Stock[]
  stockTransfers                          StockTransfer[]

  @@map("items")
}

model Location {
  id                       String                    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  companyId                String                    @map("company_id") @db.Uuid
  name                     String
  address                  String?
  createdAt                DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  seller_name              String?
  seller_phone             String?
  commission_rate          Decimal?                  @default(0) @db.Decimal(5, 2)
  is_active                Boolean?                  @default(true)
  catalogType              String                    @default("all") @map("catalog_type")
  clients                  Client[]
  commissions              Commission[]
  expenses                 Expense[]
  recurringExpenses        RecurringExpense[]
  purchaseOrderAllocations PurchaseOrderAllocation[]
  purchaseOrders           PurchaseOrder[]
  reservations             Reservation[]
  sales                    Sale[]
  sellers                  Seller[]
  stock                    Stock[]
  transfersFrom            StockTransfer[]           @relation("FromLocation")
  transfersTo              StockTransfer[]           @relation("ToLocation")
  wallets                  Wallet[]
  financeObligations       FinanceObligation[]
  userLocationAccess       UserLocationAccess[]
  walletReconciliations    WalletReconciliation[]
  notifications            UserNotification[]
  ledgerEntries            FinanceLedgerEntry[]

  @@index([catalogType], map: "idx_locations_catalog_type")
  @@map("locations")
}

model Stock {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  itemId     String   @map("item_id") @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  quantity   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([itemId, locationId])
  @@map("stock")
}

model StockTransfer {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  itemId         String   @map("item_id") @db.Uuid
  fromLocationId String   @map("from_location_id") @db.Uuid
  toLocationId   String   @map("to_location_id") @db.Uuid
  quantity       Int
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  fromLocation   Location @relation("FromLocation", fields: [fromLocationId], references: [id], onDelete: Cascade)
  item           Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  toLocation     Location @relation("ToLocation", fields: [toLocationId], references: [id], onDelete: Cascade)

  @@map("stock_transfers")
}

model ExchangeRate {
  id       String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  usdToSrd Decimal  @map("usd_to_srd") @db.Decimal(18, 8)
  setAt    DateTime @default(now()) @map("set_at") @db.Timestamptz(6)
  isActive Boolean  @default(true) @map("is_active")

  @@map("exchange_rates")
}

model Client {
  id              String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name            String
  phone           String?
  email           String?
  notes           String?
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  location_id     String?         @db.Uuid
  locations       Location?       @relation(fields: [location_id], references: [id], onUpdate: NoAction)
  purchase_orders PurchaseOrder[]
  reservations    Reservation[]

  @@index([location_id], map: "idx_clients_location")
  @@map("clients")
}

model Reservation {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  clientId       String   @map("client_id") @db.Uuid
  itemId         String   @map("item_id") @db.Uuid
  locationId     String   @map("location_id") @db.Uuid
  quantity       Int
  status         String   @default("pending")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  combo_id       String?
  combo_price    Decimal? @db.Decimal(18, 4)
  original_price Decimal? @db.Decimal(18, 4)
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  item           Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location       Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@map("reservations")
}

model Sale {
  id                     String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  companyId              String                @map("company_id") @db.Uuid
  locationId             String                @map("location_id") @db.Uuid
  sellerId               String?               @map("seller_id") @db.Uuid
  currency               String
  exchangeRate           Decimal?              @map("exchange_rate") @db.Decimal(18, 8)
  totalAmount            Decimal               @map("total_amount") @db.Decimal(18, 4)
  paymentMethod          String?               @map("payment_method")
  notes                  String?
  createdAt              DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  wallet_id              String?               @db.Uuid
  status                 String                @default("posted")
  voidedAt               DateTime?             @map("voided_at") @db.Timestamptz(6)
  voidedBy               String?               @map("voided_by") @db.Uuid
  voidReason             String?               @map("void_reason")
  correlationId          String?               @map("correlation_id") @db.Uuid
  needsReview            Boolean               @default(false) @map("needs_review")
  reviewReason           String?               @map("review_reason")
  invoiceNumber          String?               @unique @map("invoice_number")
  invoiceIsReconstructed Boolean               @default(false) @map("invoice_is_reconstructed")
  commissions            Commission[]
  saleItems              SaleItem[]
  location               Location              @relation(fields: [locationId], references: [id], onDelete: Cascade)
  seller                 Seller?               @relation(fields: [sellerId], references: [id])
  wallets                Wallet?               @relation(fields: [wallet_id], references: [id], onUpdate: NoAction)
  voidedByUser           User?                 @relation("SaleVoidedBy", fields: [voidedBy], references: [id], onDelete: SetNull)
  wallet_transactions    wallet_transactions[]

  @@index([status])
  @@map("sales")
}

model SaleItem {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  companyId       String?  @map("company_id") @db.Uuid
  saleId          String   @map("sale_id") @db.Uuid
  itemId          String   @map("item_id") @db.Uuid
  quantity        Int
  unitPrice       Decimal  @map("unit_price") @db.Decimal(18, 4)
  subtotal        Decimal  @db.Decimal(18, 4)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  is_custom_price Boolean? @default(false)
  original_price  Decimal? @db.Decimal(18, 4)
  discount_reason String?
  unitCostUsd     Decimal? @map("unit_cost_usd") @db.Decimal(18, 4)
  fxRateAtSale    Decimal? @map("fx_rate_at_sale") @db.Decimal(18, 8)
  costIsEstimated Boolean  @default(true) @map("cost_is_estimated")
  item            Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  sale            Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("sale_items")
}

model Wallet {
  id                    String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  companyId             String                 @map("company_id") @db.Uuid
  personName            String                 @map("person_name")
  type                  String
  currency              String
  balance               Decimal                @default(0) @db.Decimal(18, 4)
  purpose               String                 @default("operational")
  physicallyVerifiedAt  DateTime?              @map("physically_verified_at") @db.Timestamptz(6)
  baselineEstablishedAt DateTime?              @map("baseline_established_at") @db.Timestamptz(6)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  location_id           String?                @db.Uuid
  expenses              Expense[]
  purchaseOrders        PurchaseOrder[]
  sales                 Sale[]
  wallet_transactions   wallet_transactions[]
  locations             Location?              @relation(fields: [location_id], references: [id], onUpdate: NoAction)
  reconciliations       WalletReconciliation[]
  recurringExpenses     RecurringExpense[]
  notifications         UserNotification[]
  ledgerEntries         FinanceLedgerEntry[]

  @@unique([location_id, type, currency, purpose], map: "wallets_location_type_currency_purpose_key")
  @@index([location_id], map: "idx_wallets_location")
  @@index([location_id, type, currency, purpose], map: "idx_wallets_location_type_currency_purpose")
  @@map("wallets")
}

model ExpenseCategory {
  id                String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name              String
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  expenses          Expense[]
  recurringExpenses RecurringExpense[]
  ledgerEntries     FinanceLedgerEntry[]

  @@map("expense_categories")
}

model Expense {
  id                  String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  companyId           String                @map("company_id") @db.Uuid
  categoryId          String?               @map("category_id") @db.Uuid
  walletId            String                @map("wallet_id") @db.Uuid
  amount              Decimal               @db.Decimal(18, 4)
  currency            String
  description         String?
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  location_id         String?               @db.Uuid
  expenseDate         DateTime?             @map("expense_date") @db.Date
  vendorName          String?               @map("vendor_name")
  receiptNumber       String?               @map("receipt_number")
  classification      String                @default("unclassified")
  status              String                @default("posted")
  refundedAt          DateTime?             @map("refunded_at") @db.Timestamptz(6)
  refundReason        String?               @map("refund_reason")
  reviewedAt          DateTime?             @map("reviewed_at") @db.Timestamptz(6)
  reviewedByUserId    String?               @map("reviewed_by_user_id") @db.Uuid
  needsReview         Boolean               @default(false) @map("needs_review")
  reviewReason        String?               @map("review_reason")
  recurringExpenseId  String?               @map("recurring_expense_id") @db.Uuid
  periodKey           String?               @map("period_key")
  payoutRunId         String?               @map("payout_run_id") @db.Uuid
  category            ExpenseCategory?      @relation(fields: [categoryId], references: [id])
  locations           Location?             @relation(fields: [location_id], references: [id], onUpdate: NoAction)
  wallet              Wallet                @relation(fields: [walletId], references: [id], onDelete: Cascade)
  reviewedBy          User?                 @relation("ExpenseReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  recurringExpense    RecurringExpense?     @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)
  wallet_transactions wallet_transactions[]

  @@index([location_id], map: "idx_expenses_location")
  @@index([status, classification, expenseDate(sort: Desc), createdAt(sort: Desc)], map: "idx_expenses_financial_review")
  @@map("expenses")
}

model RecurringExpense {
  id                   String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name                 String
  vendorName           String           @map("vendor_name")
  amount               Decimal          @db.Decimal(18, 4)
  currency             String           @default("USD")
  cadence              String           @default("monthly")
  anchorDay            Int              @default(1) @map("anchor_day")
  walletId             String?          @map("wallet_id") @db.Uuid
  locationId           String?          @map("location_id") @db.Uuid
  categoryId           String?          @map("category_id") @db.Uuid
  classification       String           @default("operating")
  nextRunOn            DateTime         @map("next_run_on") @db.Date
  lastPostedAt         DateTime?        @map("last_posted_at") @db.Timestamptz(6)
  isActive             Boolean          @default(true) @map("is_active")
  autoPost             Boolean          @default(true) @map("auto_post")
  amountIsEstimated    Boolean          @default(false) @map("amount_is_estimated")
  anchorDayIsEstimated Boolean          @default(false) @map("anchor_day_is_estimated")
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  wallet               Wallet?          @relation(fields: [walletId], references: [id], onDelete: Restrict)
  location             Location?        @relation(fields: [locationId], references: [id], onDelete: SetNull)
  category             ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  expenses             Expense[]

  @@map("recurring_expenses")
}

model Founder {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name         String
  userId       String?  @map("user_id") @db.Uuid
  splitPercent Decimal  @map("split_percent") @db.Decimal(5, 2)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("founders")
}

model PayoutRun {
  id                String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  periodKey         String    @map("period_key")
  status            String    @default("draft")
  trailingMonths    Int       @default(3) @map("trailing_months")
  trailingAvgProfit Decimal   @default(0) @map("trailing_avg_profit") @db.Decimal(18, 4)
  distributable     Decimal   @default(0) @db.Decimal(18, 4)
  savingsAmount     Decimal   @default(0) @map("savings_amount") @db.Decimal(18, 4)
  foundersAmount    Decimal   @default(0) @map("founders_amount") @db.Decimal(18, 4)
  restockCeiling    Decimal   @default(0) @map("restock_ceiling") @db.Decimal(18, 4)
  currency          String    @default("SRD")
  sourceWalletId    String?   @map("source_wallet_id") @db.Uuid
  savingsWalletId   String?   @map("savings_wallet_id") @db.Uuid
  correlationId     String    @default(dbgenerated("uuid_generate_v4()")) @map("correlation_id") @db.Uuid
  blockedBy         String?   @map("blocked_by")
  blockedDetail     String?   @map("blocked_detail")
  computedAt        DateTime  @default(now()) @map("computed_at") @db.Timestamptz(6)
  postedAt          DateTime? @map("posted_at") @db.Timestamptz(6)
  reversedAt        DateTime? @map("reversed_at") @db.Timestamptz(6)
