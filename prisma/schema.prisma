  @@index([walletId, reconciledAt(sort: Desc)], map: "idx_wallet_reconciliations_wallet_recent")
  @@map("wallet_reconciliations")
}

model UserNotification {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  walletId         String?   @map("wallet_id") @db.Uuid
  locationId       String?   @map("location_id") @db.Uuid
  notificationType String    @map("notification_type")
  title            String
  body             String
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  readAt           DateTime? @map("read_at") @db.Timestamptz(6)
  resolvedAt       DateTime? @map("resolved_at") @db.Timestamptz(6)
  metadata         Json      @default("{}")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet           Wallet?   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  location         Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)], map: "idx_user_notifications_user_unread")
  @@map("user_notifications")
}

model FinanceLedgerEntry {
  id                  String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  companyId           String?              @map("company_id") @db.Uuid
  walletTransactionId String?              @unique @map("wallet_transaction_id") @db.Uuid
  walletId            String?              @map("wallet_id") @db.Uuid
  locationId          String?              @map("location_id") @db.Uuid
  sellerId            String?              @map("seller_id") @db.Uuid
  categoryId          String?              @map("category_id") @db.Uuid
  actorUserId         String?              @map("actor_user_id") @db.Uuid
  eventType           String               @map("event_type")
  direction           String
  amount              Decimal              @db.Decimal(18, 4)
  currency            String               @db.VarChar(10)
  sourceType          String?              @map("source_type")
  sourceId            String?              @map("source_id") @db.Uuid
  counterparty        String?
  description         String?
  correlationId       String               @default(dbgenerated("uuid_generate_v4()")) @map("correlation_id") @db.Uuid
  occurredAt          DateTime             @default(now()) @map("occurred_at") @db.Timestamptz(6)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  metadata            Json                 @default("{}")
  walletTransaction   wallet_transactions? @relation(fields: [walletTransactionId], references: [id], onDelete: Restrict)
  wallet              Wallet?              @relation(fields: [walletId], references: [id], onDelete: Restrict)
  location            Location?            @relation(fields: [locationId], references: [id], onDelete: SetNull)
  seller              Seller?              @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  category            ExpenseCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  actor               User?                @relation("LedgerActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([occurredAt(sort: Desc)], map: "idx_finance_ledger_entries_occurred")
  @@index([walletId, occurredAt(sort: Desc)], map: "idx_finance_ledger_entries_wallet_occurred")
  @@index([locationId, occurredAt(sort: Desc)], map: "idx_finance_ledger_entries_location_occurred")
  @@index([sourceType, sourceId], map: "idx_finance_ledger_entries_source")
  @@map("finance_ledger_entries")
}
