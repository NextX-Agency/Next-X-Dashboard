<?xml version="1.0" encoding="utf-8"?>
<!--
  NextX POS receipt, 80 mm thermal, black and white only.
  Layout: logo + shop url / bon, date, seller / items (name on its own line, then qty x price and line total) /
  TOTAAL / payments / thank-you. The logo is embedded because this template also renders inside the POS browser,
  where module static paths and Python helpers are not available.
  Regenerate the logo with odoo/ops/build_receipt_logo.py.
-->
<odoo>
    <!-- ================= header ================= -->
    <template id="pos_order_receipt_header_nextx" inherit_id="point_of_sale.pos_order_receipt_header" name="NextX POS receipt header">
        <xpath expr="//div[@name='logo']" position="replace">
            <div class="w-100 text-center" name="logo">
                <img src="data:image/png;base64," style="width: 300px !important; max-width: 70% !important; height: auto !important;"/>
                <div class="text-large" style="letter-spacing: 1px;">shop-nextx.com</div>
            </div>
        </xpath>
        <xpath expr="//div[@name='ticket_reference']/parent::div" position="replace">
            <table class="w-100 mt-3 mb-2" style="border-top: 2px dashed #000; border-bottom: 2px dashed #000;" name="receipt_meta">
                <tbody>
                    <tr><td class="text-start w-30">Bon</td><td class="text-end"><t t-out="order['pos_reference']"/></td></tr>
                    <tr><td class="text-start w-30">Datum</td><td class="text-end"><t t-out="extra_data['formated_date_order']"/></td></tr>
                    <tr t-if="extra_data['cashier_name']"><td class="text-start w-30">Verkoper</td><td class="text-end cashier-name"><t t-out="extra_data['cashier_name']"/></td></tr>
                </tbody>
            </table>
        </xpath>
        <xpath expr="//div[@name='cashier_name']" position="replace"/>
    </template>

    <!-- ================= totals, payments ================= -->
    <template id="pos_order_receipt_nextx" inherit_id="point_of_sale.pos_order_receipt" name="NextX POS receipt body">
        <xpath expr="//div[@name='simplified_receipt_label']/strong" position="replace"><strong>Bon</strong></xpath>

        <xpath expr="//div[@name='prices']" position="replace">
            <div class="w-100 mb-3" name="prices" t-if="not conditions['basic_receipt']" style="border-top: 2px dashed #000; padding-top: 8px;">
                <table class="w-100">
                    <tbody>
                        <tr t-if="extra_data['prices'].get('discount_amount')">
                            <td class="text-start" name="discount">Korting</td>
                            <td class="text-end font-monospace discount-amount" t-out="extra_data['prices']['discount_amount']"/>
                        </tr>
                        <t t-foreach="extra_data['prices']['taxes']" t-as="tax">
                            <tr name="taxes_line">
                                <td class="text-start"><t t-out="tax['name']"/></td>
                                <td class="text-end font-monospace"><t t-out="tax['amount']"/></td>
                            </tr>
                        </t>
                        <tr t-if="extra_data['prices'].get('rounding_amount')">
                            <td class="text-start" name="rounding">Afronding</td>
                            <td class="text-end font-monospace rounding-amount" t-out="extra_data['prices']['rounding_amount']"/>
                        </tr>
                        <tr class="text-bold" style="font-size: 30px;">
                            <td class="text-start" name="total">TOTAAL</td>
                            <td class="text-end"><span class="total-amount font-monospace" t-out="extra_data['prices']['total_amount']"/></td>
                        </tr>
                        <t t-foreach="payments" t-as="payment" name="payments">
                            <tr class="payment-line" t-if="not payment.get('is_change')">
                                <td class="text-start" t-out="payment['payment_method_data']['name']"/>
                                <td class="text-end font-monospace" t-out="payment['amount']"/>
                            </tr>
                        </t>
                        <t t-foreach="payments" t-as="payment" name="change_payments">
                            <tr t-if="payment.get('is_change')">
                                <td class="text-start" name="change">Wisselgeld</td>
                                <td class="text-end change-amount font-monospace" t-out="payment['amount'].replace('-', '')"/>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </xpath>

        <!-- the item count and the self-invoicing QR (it would send customers to the Odoo server) are not wanted -->
        <xpath expr="//table[@name='total_item_count']" position="replace"/>
        <xpath expr="//div[@class='w-100'][./table//img[hasclass('invoice-qr-code')]]" position="replace"/>
    </template>

    <!-- ================= line items ================= -->
    <template id="pos_orderline_receipt_nextx" inherit_id="point_of_sale.pos_orderline_receipt" name="NextX POS receipt line">
        <xpath expr="//tr[@name='standard-line']" position="replace">
            <t t-if="not line['combo_parent_id']">
                <tr name="standard-line" class="lines">
                    <td colspan="2" class="text-start top" style="padding-top: 10px;"><div name="product-name" class="name text-normal text-bold" t-out="line['product_data']['display_name']"/></td>
                </tr>
                <tr class="lines">
                    <td class="text-start top">
                        <span class="qty text-normal"><t t-out="line['qty']"/></span> <span class="text-normal">x</span> <span class="price-unit text-normal font-monospace" t-out="line['unit_price']"/>
                        <t t-if="line['discount'] and not conditions['basic_receipt']"><span class="no-discount-price"> (-<t t-out="int(line['discount']) if line['discount'] == int(line['discount']) else line['discount']"/>%)</span></t>
                    </td>
                    <td t-if="not conditions['basic_receipt']" class="text-end top price-incl text-normal font-monospace" t-out="line['price_subtotal_incl']"/>
                </tr>
                <tr t-if="line['customer_note']"><td colspan="2" class="text-start text-small"><span class="line-note" t-out="line['customer_note']"/></td></tr>
            </t>
        </xpath>
    </template>

    <!-- ================= footer ================= -->
    <template id="pos_order_receipt_footer_nextx" inherit_id="point_of_sale.pos_order_receipt_footer" name="NextX POS receipt footer">
        <xpath expr="//div[@name='footer']/parent::div" position="replace">
            <div class="w-100 text-center mt-3" style="border-top: 2px dashed #000; padding-top: 12px;">
                <div class="w-100 mt-2" name="footer"/>
                <div class="text-large text-bold">Bedankt voor je aankoop.</div>
                <div class="text-large">shop-nextx.com</div>
                <!-- shop name, plus address / phone / tax id only once they are filled in on the POS config or company -->
                <div class="text-small mt-2" t-if="config.get('name')" t-out="config['name']"/>
                <div class="text-small" t-if="config.get('receipt_address')" t-out="config['receipt_address']"/>
                <div class="text-small" t-if="config.get('phone')">Tel: <t t-out="config['phone']"/></div>
                <div class="text-small" t-if="company.get('vat') and extra_data.get('vat_label')"><t t-out="extra_data['vat_label']"/>: <t t-out="company['vat']"/></div>
            </div>
        </xpath>
    </template>
</odoo>
