<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="pos_order_receipt_header_nextx"
              inherit_id="point_of_sale.pos_order_receipt_header"
              name="NextX POS receipt header">
        <xpath expr="//div[@name='logo']/img" position="attributes">
            <attribute name="class">mx-auto d-block</attribute>
            <attribute name="style">display: block; margin: 0 auto; width: 48mm; max-width: 100%; max-height: 24mm; height: auto; object-fit: contain;</attribute>
        </xpath>
        <xpath expr="//span[@name='ticket']" position="replace">
            <span name="ticket">Bon</span>
        </xpath>
        <xpath expr="//span[@name='served_by']" position="replace">
            <span name="served_by">Verkoper:</span>
        </xpath>
    </template>

    <template id="pos_order_receipt_nextx"
              inherit_id="point_of_sale.pos_order_receipt"
              name="NextX POS receipt copy">
        <xpath expr="//div[@name='simplified_receipt_label']/strong" position="replace">
            <strong>Bon</strong>
        </xpath>
        <xpath expr="//table[@name='total_item_count']" position="replace"/>
    </template>

    <template id="pos_order_receipt_footer_nextx"
              inherit_id="point_of_sale.pos_order_receipt_footer"
              name="NextX POS receipt footer">
        <xpath expr="//strong[normalize-space()='Odoo']/parent::div" position="replace">
            <div class="w-100 text-center mt-3">NextX</div>
        </xpath>
    </template>

    <template id="pos_orderline_receipt_information_nextx"
              inherit_id="point_of_sale.pos_orderline_receipt_information"
              name="NextX Dutch POS line discount">
        <xpath expr="//div[hasclass('no-discount-price')]" position="replace">
            <div t-if="line['discount'] and not conditions['basic_receipt'] and not line['combo_parent_id']" class="text-small no-discount-price">
                <span>Korting </span><t t-out="line['discount']"/>% <span>op </span><t t-out="line['no_discount_price']"/>
            </div>
        </xpath>
    </template>
</odoo>
