# Installed to /etc/logrotate.d/nextx by deploy/vps/install-ops.sh.
# Docker container logs are rotated by the json-file driver options in the Compose file
# (max-size 10m, max-file 5), not here.
/var/log/nextx/*.log {
    weekly
    rotate 8
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    create 0600 root root
}

# deploy-pinned.sh appends one line per deploy to this file (path filled in by the installer).
@DEPLOY_LOG@ {
    monthly
    rotate 12
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
}
