{
  "name": "nextly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "migrate:nextx:inspect": "tsx scripts/migrate-nextx/cli.ts inspect",
    "migrate:nextx:dry-run": "tsx scripts/migrate-nextx/cli.ts dry-run",
    "migrate:nextx:media-audit": "tsx scripts/migrate-nextx/cli.ts media-audit",
    "migrate:nextx:run": "tsx scripts/migrate-nextx/cli.ts migrate",
    "migrate:nextx:validate": "tsx scripts/migrate-nextx/cli.ts validate",
    "migrate:nextx:media-prepare": "tsx scripts/migrate-nextx/cli.ts media-prepare",
    "migrate:nextx:owner-review": "tsx scripts/migrate-nextx/cli.ts owner-review",
    "migrate:nextx:readiness-fingerprint": "tsx scripts/migrate-nextx/cli.ts readiness-fingerprint",
    "integration:credential": "tsx scripts/agent-integration.ts",
    "db:rehearsal:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/rehearsal/rehearsal.ps1 start",
    "db:rehearsal:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/rehearsal/rehearsal.ps1 stop",
    "db:rehearsal:migrate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/rehearsal/rehearsal.ps1 migrate",
    "db:rehearsal:seed": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/rehearsal/rehearsal.ps1 seed",
    "db:rehearsal:validate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/rehearsal/rehearsal.ps1 validate",
    "db:rehearsal:rls": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/rehearsal/rehearsal.ps1 rls",
    "db:rehearsal:constraints": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/rehearsal/rehearsal.ps1 constraints",
    "db:rehearsal:concurrency": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/rehearsal/rehearsal.ps1 concurrency",
    "db:rehearsal:run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/rehearsal/rehearsal.ps1 rehearse",
    "migrate:nextx:snapshot": "tsx scripts/migrate-nextx/cli.ts snapshot"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-visually-hidden": "^1.2.11",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3-shape": "^3.2.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.38.0",
    "next": "^16.3.4",
    "next-safe-action": "^8.6.1",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.1",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "sharp": "0.35.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
