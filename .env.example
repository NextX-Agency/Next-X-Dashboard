# ─── Supabase Auth and Storage ───────────────────────────────────────────────
# For production, use the public API/Auth/Storage origin of the VPS-hosted stack.
# Managed Supabase is for isolated development or the read-only legacy source only.
NEXT_PUBLIC_SUPABASE_URL="https://supabase.example.com"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Server-only. Never expose. Required for signed product image uploads.
SUPABASE_SECRET_KEY="sb_secret_..."
# Media migration requires all readiness gates to pass and a matching report.
# Must match the HTTPS self-hosted staging Supabase hostname exactly.
NEXTX_STAGING_HOST="supabase-staging.example.com"

# ─── Database (Drizzle) ──────────────────────────────────────────────────────
# Production must use "self-hosted" and private VPS service URLs. Managed pooler
# URLs are allowed only outside the production runtime.
NEXTLY_DATABASE_MODE="self-hosted"
# Runtime transaction-pool connection over the private Coolify network.
DATABASE_URL="postgresql://postgres.<tenant-id>:<password>@supavisor:6543/postgres"
# Direct/private PostgreSQL connection for migrations and import validation.
DIRECT_URL="postgresql://postgres:<password>@db:5432/postgres"

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://nextx-staging.example.com"
CRON_SECRET="replace-with-a-long-random-secret"
